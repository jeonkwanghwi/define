{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npx expo export --platform web"
  },
  "deploy": {
    "startCommand": "npx serve dist -l tcp://0.0.0.0:8081",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
