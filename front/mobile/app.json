{
  "expo": {
    "name": "define",
    "slug": "define",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/define.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.define.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.define.app",
      "adaptiveIcon": {
        "backgroundColor": "#FCFAF6",
        "foregroundImage": "./assets/images/define.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/define.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFAF6",
          "android": {
            "image": "./assets/images/define.png",
            "imageWidth": 96
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55e40889-4c83-4615-8796-55d9efca9e55"
      }
    },
    "owner": "kwanghwis-team"
  }
}
