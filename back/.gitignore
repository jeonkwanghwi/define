.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.cache

# 로그 / 로컬 DB
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

