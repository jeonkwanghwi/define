# 실제 값은 back/.env 에 (이 파일은 예시·커밋용).
# DATABASE_URL·JWT_SECRET는 폴백이 없다 — 없으면 서버가 뜨지 않는다(배포에서 빼먹는 사고 방지).

# 로컬: back/docker-compose.yml의 Postgres. 배포: RDS 엔드포인트.
DATABASE_URL="postgresql://define:define@localhost:5432/define?schema=public"
JWT_SECRET="여기에-충분히-긴-랜덤-문자열"
JWT_EXPIRES_IN="90d"
PORT=3000

# CORS 허용 출처 화이트리스트(콤마 구분). 미설정이면 요청 출처를 그대로 허용(로컬 개발용).
# 운영에선 반드시 프론트 도메인만 나열할 것.
# CORS_ORIGINS="https://d1234.cloudfront.net"

# ─── tab3 회상(과거의 나와 대화) LLM API — 제공자 미정(GPT/Claude/Gemini) ───
# "감성적인" 모델 선정 후 하나만 골라 back/.env 에 실제 키를 채운다. (키는 절대 프론트에 두지 않음 — 서버에서만 호출)
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""

# ─── 카카오 로그인 ───
# 카카오디벨로퍼스 > 내 앱 > 앱 > 플랫폼 키에서 확인.
# 시크릿은 신규 REST API 키에 기본 활성화되어 있어 토큰 교환에 반드시 필요하다.
# 둘 다 비면 POST /api/auth/kakao가 503(이메일 로그인은 정상 동작).
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 소셜 로그인 후 앱으로 돌아올 커스텀 스킴. front/mobile/app.json의 scheme과 같아야 한다.
APP_SCHEME=define

# Apple 로그인 — identityToken의 audience 검증용.
# front/mobile/app.json의 ios.bundleIdentifier와 반드시 같아야 한다(다르면 전부 401).
APPLE_BUNDLE_ID=com.kwanghwi.define

# 어드민 키(카카오디벨로퍼스 > 앱 > 어드민 키). 탈퇴 시 연결 해제에 쓴다.
# 서버 전용 — 앱 번들에 절대 넣지 않는다. 없으면 탈퇴는 되고 카카오 연결만 남는다.
KAKAO_ADMIN_KEY=
