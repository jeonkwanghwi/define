// Prisma 스키마 — DB 구조의 단일 출처(SSOT).
// 이 파일을 바꾸고 `npm run prisma:migrate` 하면 DB 테이블이 따라 바뀐다.
//
// DB: PostgreSQL (2026-09-05 SQLite에서 전환 — AWS RDS 이관).
// provider가 바뀌면 마이그레이션 SQL도 provider 종속이라 재생 불가 → migrations를 init 하나로 재베이스라인했다.
// (service 코드는 repository 구현체가 격리해줘서 무변경.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 추천 단어 풀 — "오늘의 단어"로 서버가 내려주는 단어들.
/// 카테고리 없음(저장 형식·분류는 팀 논의 보류 — DEVELOPMENT.md 참조).
model Word {
  /// cuid: 충돌 거의 없는 문자열 ID. 백엔드가 발급.
  id        String   @id @default(cuid())
  /// 단어 자체. 중복 방지(unique).
  text      String   @unique
  createdAt DateTime @default(now())

  @@map("words") // 실제 테이블명은 words (소문자 복수형 관례)
}

/// 가입 사용자. 익명 모델 → 가입 시 닉네임 미설정 허용(nullable).
///
/// email·passwordHash가 nullable인 이유: 소셜 로그인(카카오) 사용자는 둘 다 없다.
/// 카카오는 비즈 앱 전환 전엔 이메일 동의항목 권한 자체가 없고, 전환해도 사용자가
/// 거부할 수 있다(Apple은 "이메일 가리기"가 있다). 그래서 이메일을 계정의
/// 필수 식별자로 둘 수 없다 → 소셜 계정의 정체성은 AuthIdentity가 맡는다.
model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  passwordHash String?
  /// 표시 이름. 익명 모델이라 미설정(null) 허용. 설정 시엔 전역 중복 방지(unique).
  nickname     String?  @unique
  createdAt    DateTime @default(now())
  entries      Entry[]
  likes        Like[]
  // ─── 프로필(마을 필터용). 완성 전까지 null. ───
  birthYear    Int?
  gender       String?        // 'male' | 'female'
  interests    UserInterest[]
  // ─── 재화(잉크). balance는 중립어(이름 안 박음). lastAttendanceDate로 하루 1회 적립 멱등. ───
  balance            Int     @default(0)
  lastAttendanceDate String?
  recallConsentAt    DateTime?   // tab3 회상 AI 데이터 동의 시각. null=미동의.
  lastRewardedStreakDay Int      @default(0)   // 기록 연속 보너스: 지급한 최고 연속일(멱등 마커).
  // 회상 채팅 말투 프로필 — 사용자 발화에서 추출한 말투 특징 요약(대화 원문은 저장 안 함).
  // 대화가 쌓일수록 갱신 → "과거의 나"가 첫 마디부터 이 사람 말투로 말하게 하는 재료.
  speechProfile      String?
  identities         AuthIdentity[]

  @@map("users")
}

/// 소셜 로그인 연결 — "이 제공자의 이 계정은 우리 유저 X다".
///
/// providerSub = 제공자가 준 고유 식별자. 카카오는 회원번호(OIDC id_token의 sub),
/// Apple도 같은 자리의 sub다. 이름·이메일 같은 개인정보는 받지 않는다 —
/// 로그인에 필요한 건 "같은 사람인지" 뿐이고, 그건 이 값 하나로 충분하다.
///
/// 카카오 회원번호는 **앱 단위**라 다른 서비스의 번호와 대조해도 같은 사람인지 알 수 없다
/// (그 역할을 하는 account_ci는 받지 않는다). 다만 특정 개인을 구별하는 식별자이므로
/// 개인정보처리방침 수집 항목에 적고, 탈퇴 시 파기 + 제공자 연결 해제 대상이다.
///
/// 한 유저가 여러 제공자를 붙일 수 있게 User 1:N. 같은 제공자 계정이 두 유저에
/// 붙는 것은 (provider, providerSub) 유니크로 막는다.
model AuthIdentity {
  id          String   @id @default(cuid())
  provider    String   // 'kakao' | 'apple'
  providerSub String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([provider, providerSub])
  @@index([userId])
  @@map("auth_identities")
}

/// 사용자 정의 단어(entry) — 로컬 SavedEntry의 서버 쌍둥이.
/// clientId = 로컬 SavedEntry.id 보존 → (userId, clientId) 유니크로 재import 중복 방지.
model Entry {
  id         String   @id @default(cuid())
  clientId   String
  userId     String
  word       String
  text       String
  changeNote String?
  savedAt    DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes      Like[]

  @@unique([userId, clientId])
  @@map("entries")
}

/// 가입 프로필의 관심사 — User N:1. 고정 12개 중 하나(검증은 DTO).
/// JSON 컬럼이 아니라 관계 테이블: SQLite는 스칼라 리스트 미지원 + 마을 필터 쿼리 대비.
model UserInterest {
  id       String @id @default(cuid())
  userId   String
  interest String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, interest])
  @@map("user_interests")
}

/// 광장 좋아요(추천) — 한 사용자가 한 정의(Entry)에 1회. (userId, entryId) 유니크로 멱등.
/// 신규 테이블. 광장 2단계에서 도입.
model Like {
  id        String   @id @default(cuid())
  userId    String
  entryId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId])
  @@map("likes")
}

/// LLM 호출 사용량·비용 원장. 호출 1건 = 1행. 회상(및 향후 AI 기능) 토큰·비용 모니터링.
/// 원시 토큰이 진실의 원천 — costUsd는 가격표로 계산한 편의값(가격 바뀌면 토큰에서 재계산).
model LlmUsage {
  id               String   @id @default(cuid())
  userId           String
  feature          String   // 'recall' 등 호출 기능 구분
  model            String   // 실제 응답 모델(예: gpt-4.1-mini-2025-04-14)
  promptTokens     Int
  cachedTokens     Int      @default(0)
  completionTokens Int
  totalTokens      Int
  costUsd          Float
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([model])
  @@map("llm_usage")
}
