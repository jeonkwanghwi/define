// Prisma 스키마 — DB 구조의 단일 출처(SSOT).
// 이 파일을 바꾸고 `npm run prisma:migrate` 하면 DB 테이블이 따라 바뀐다.
//
// DB 스왑 준비: provider만 "sqlite" → "postgresql"로 바꾸면 같은 스키마로 이전 가능.
// (실제 교체는 repository 구현체가 격리해주므로 service 코드는 무변경.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 추천 단어 풀 — "오늘의 단어"로 서버가 내려주는 단어들.
/// 카테고리 없음(저장 형식·분류는 팀 논의 보류 — DEVELOPMENT.md 참조).
model Word {
  /// cuid: 충돌 거의 없는 문자열 ID. 백엔드가 발급.
  id        String   @id @default(cuid())
  /// 단어 자체. 중복 방지(unique).
  text      String   @unique
  createdAt DateTime @default(now())

  @@map("words") // 실제 테이블명은 words (소문자 복수형 관례)
}
